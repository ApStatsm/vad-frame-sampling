# Generated outputs: track only consolidated setup reports and run summaries.
# Per-run diagnostic folders (ranking/per_block CSV, arrays, source audits) stay
# local; docs/EXTRACTION_DIAGNOSTIC_RUNS.md and the consolidated JSONs summarise them.
/outputs/**
!/outputs/*/
!/outputs/setup/*.json
!/outputs/setup/*.csv
!/outputs/setup/*.txt
!/outputs/setup/*.log
!/outputs/baseline/*/
!/outputs/baseline/*/summary.json
!/outputs/baseline/*/cohort_sensitivity.json
