# Share original small audit reports and summaries, not generated binary outputs
/outputs/**
!/outputs/**/
!/outputs/**/*.json
!/outputs/**/*.csv
!/outputs/**/*.txt
!/outputs/**/*.log

# Bundled GT .npy files and CLIP tokenizer .txt.gz remain tracked.
