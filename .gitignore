# Local history backups and reference synchronization
/.local-backups/
/sources/

# Python environments and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Machine-specific files and credentials
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.cookie
*.cookies
configs/*.local.json

# Raw inputs stay local. Preserve only preparation guidance and small test lists.
/UCF-Crime/*
!/UCF-Crime/README.md
!/UCF-Crime/Temporal_Anomaly_Annotation_for_Testing_Videos.txt
!/UCF-Crime/test/
/UCF-Crime/test/*
!/UCF-Crime/test/README.md
!/UCF-Crime/test/splits/
!/UCF-Crime/test/annotations/

# Official feature arrays and pretrained weights
/features/*
!/features/README.md
/checkpoints/*
!/checkpoints/README.md

# Machine-local audit reports, CSVs, raw scores and logs
/outputs/
*.mp4
*.avi
*.mkv
*.mov
*.pt
*.pth
*.ckpt
*.npz
*.zip
*.part
*.log

# Do not globally ignore .npy or .gz: bundled GT and CLIP tokenizer are inputs.
