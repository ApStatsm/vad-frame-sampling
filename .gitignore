# Local backups, synced references and environments
/.local-backups/
/sources/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Local machine and authentication files
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.cookie
*.cookies
configs/*.local.json

# Large inputs; small annotations, manifests and split lists remain shareable
/features/
/checkpoints/
/UCF-Crime/extracted/
/UCF-Crime/test/Anomaly/
/UCF-Crime/test/Normal/
*.mp4
*.avi
*.mkv
*.mov
*.pt
*.pth
*.ckpt
*.zip
